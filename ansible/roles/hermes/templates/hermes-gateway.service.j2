# Managed by lycus (ansible/roles/hermes). Do not edit on the host.
#
# Deliberately templated rather than generated by `hermes gateway install`.
# That command prompts ("Start the gateway now after installing the service?
# [Y/n]:") with no flag to suppress it, and taking its default starts the
# service — which this project specifically does not want at provision time.
# Every value below is static, so there is nothing the CLI knows that we do not.
#
# Kept in step with what `hermes gateway install --system` generates; if the
# upstream unit gains fields, diff it against this file.

[Unit]
Description=Hermes Agent Gateway - Messaging Platform Integration
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# The agent runs unprivileged. Root installs the code; it never executes it.
User={{ hermes_user }}
Group={{ hermes_user }}
ExecStart={{ hermes_install_dir }}/venv/bin/python -m hermes_cli.main gateway run --replace
WorkingDirectory={{ hermes_install_dir }}
Environment="HOME=/home/{{ hermes_user }}"
Environment="USER={{ hermes_user }}"
Environment="LOGNAME={{ hermes_user }}"
Environment="PATH={{ hermes_install_dir }}/venv/bin:{{ hermes_install_dir }}/node_modules/.bin:/usr/bin:/home/{{ hermes_user }}/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV={{ hermes_install_dir }}/venv"
Environment="HERMES_HOME={{ hermes_home }}"
Restart=always
RestartSec=5
RestartMaxDelaySec=300
RestartSteps=5
RestartForceExitStatus=75
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 $MAINPID
TimeoutStopSec=210
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
